# =============================================================================
# Настройки AssemblyAI (транскрибация + speaker diarization)
# =============================================================================

# API ключ AssemblyAI
# Получить можно на: https://www.assemblyai.com/
# Стоимость: ~$0.90 за час аудио
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# Количество говорящих по умолчанию (для diarization)
# Обычно 2 для call-центра (агент + клиент)
DEFAULT_NUM_SPEAKERS=2

# =============================================================================
# Настройки транскрибации
# =============================================================================

# Язык аудиозаписей (ISO-639-1 код)
# Примеры: ru (русский), es (испанский), en (английский), de (немецкий)
# Указание языка повышает точность транскрибации
LANGUAGE=ru

# Выполнять транскрибацию разговоров
# true = выполнять транскрибацию через AssemblyAI (по умолчанию)
# false = пропустить транскрибацию (процесс остановится после создания задач в трекере)
TRANSCRIBE_CONVERSATION=true

# =============================================================================
# Настройки мониторинга USB устройств
# =============================================================================

# Интервал проверки подключения новых USB устройств (секунды)
# Каждые N секунд система проверяет наличие новых флешек
# Рекомендуется: 5 секунд
CHECK_INTERVAL=5

# Количество параллельных потоков для копирования файлов
# Рекомендуется: 3-5 потоков для USB → диск → S3 операций
# 1 = последовательное копирование (без параллелизма)
MAX_PARALLEL_COPIES=3

# =============================================================================
# Уведомления в Telegram (опционально)
# =============================================================================

# Токен бота Telegram
# Создать бота: напишите @BotFather в Telegram, команда /newbot
# Пример: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ID чата для отправки уведомлений
# Узнать свой ID: напишите @userinfobot в Telegram
# Пример: 123456789
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Включить/выключить Telegram уведомления
# true = включено, false = выключено
TELEGRAM_ENABLED=true

# =============================================================================
# Настройки сохранения результатов
# =============================================================================

# Папка для сохранения текстовых файлов с транскрипциями
# Файлы сохраняются в структуре: OUTPUT_DIR/YYYY-MM-DD/DEVICE_NAME/filename.txt
OUTPUT_DIR=output

# =============================================================================
# Настройки S3 Object Storage (для загрузки файлов в облако)
# =============================================================================

# Включить/выключить загрузку в S3
# true = файлы загружаются в S3, false = только локальное хранение
S3_ENABLED=true

# URL endpoint S3-совместимого хранилища
# Yandex Object Storage: https://storage.yandexcloud.net
# Selectel: https://s3.selcdn.ru
# VK Cloud: https://hb.vkcs.cloud
# MinIO (self-hosted): http://your-server:9000
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# Регион S3 хранилища
# Для Yandex Object Storage обычно: ru-central1
# Для AWS S3: us-east-1, eu-west-1 и т.д.
S3_REGION_NAME=ru-central1

# Access Key ID (статический ключ доступа)
# Создать в Yandex Cloud: Сервисные аккаунты -> Создать статический ключ
S3_ACCESS_KEY_ID=your-access-key-id

# Secret Access Key (секретный ключ)
# Выдается вместе с Access Key ID
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Имя бакета для хранения аудиофайлов
# Бакет должен быть создан заранее в Object Storage
# Пример: neuro-caller-audio
S3_BUCKET_NAME=neuro-caller-audio

# Класс хранилища (storage class)
# STANDARD - стандартное хранилище (быстрый доступ, ~1.5₽/GB/месяц)
# COLD - холодное хранилище (дешевле, медленнее доступ)
# ICE - ледяное хранилище (самое дешевое, архивное)
S3_STORAGE_CLASS=STANDARD

# Количество повторных попыток при ошибке загрузки
# Рекомендуется: 3
S3_RETRY_ATTEMPTS=3

# Таймаут загрузки в секундах
# Для больших файлов может потребоваться увеличить
# Рекомендуется: 300 (5 минут)
S3_UPLOAD_TIMEOUT=300

# Время жизни presigned URL в секундах
# Presigned URL - временная ссылка для скачивания файла
# 604800 секунд = 7 дней
# 86400 секунд = 1 день
S3_PRESIGNED_URL_EXPIRY=604800

# =============================================================================
# Настройки Яндекс Трекера (создание задач после загрузки в S3)
# =============================================================================

# Включить/выключить создание задач в трекере
TRACKER_ENABLED=true

# OAuth токен для Яндекс Трекера
# Получить можно на wiki.yandex-team.ru
TRACKER_OAUTH_TOKEN=your-tracker-oauth-token

# Очередь для создания задач
TRACKER_QUEUE=YANGOSCOUTS

# =============================================================================
# Настройки логирования
# =============================================================================

# Уровень логирования
# Варианты: DEBUG, INFO, WARNING, ERROR
# DEBUG - самый подробный, ERROR - только ошибки
LOG_LEVEL=INFO
