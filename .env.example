# Voximplant Configuration
VOXIMPLANT_ACCOUNT_ID=your_account_id
VOXIMPLANT_API_KEY=your_api_key
VOXIMPLANT_APP_ID=your_app_id
VOXIMPLANT_RULE_ID=your_rule_id
VOXIMPLANT_USERNAME=your_username@your_app.your_account.voximplant.com
VOXIMPLANT_PASSWORD=your_password
VOXIMPLANT_PHONE_NUMBER=+7XXXXXXXXXX

# OpenAI Configuration (остается без изменений)
OPENAI_API_KEY=sk-your-openai-api-key

# Taxi Brand Configuration (остается без изменений)
TAXI_BRAND_NAME=YourTaxiBrand
RECRUITMENT_PROMPT=Вы - дружелюбный рекрутер такси-сервиса {brand}. Ваша задача - убедить человека стать водителем в нашем сервисе.

# Logging
LOG_LEVEL=INFO